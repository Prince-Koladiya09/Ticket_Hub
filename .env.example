# Used by docker compose for the full stack. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Demo only: lets a user confirm a hold without paying (payments are not integrated yet).
# Requires NODE_ENV=development; it is ignored when NODE_ENV=production.
NODE_ENV=production
ENABLE_DEV_CONFIRM=false

# Optional SMTP; leave empty to log emails instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
