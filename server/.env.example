NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CLIENT_URL=http://localhost:5173
# directConnection=true lets this work against the single-node replica set in docker-compose
MONGO_URI=mongodb://localhost:27017/tickethub?directConnection=true
REDIS_URL=redis://localhost:6379
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
# Seconds a seat stays held while the user checks out
SEAT_LOCK_TTL=300
MAX_SEATS_PER_BOOKING=6
# Payments are not integrated yet. This flag exposes POST /bookings/:id/dev-confirm so the rest of the
# flow (tickets, emails, live seat updates) can be demoed. It is always off in production.
ENABLE_DEV_CONFIRM=true
USE_TRANSACTIONS=true
